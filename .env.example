# SIMPLE — environment variables (copy to .env or set in your host dashboard)
# Owner & creator: Daniel Pollard

# Server port (Render/Railway set PORT automatically).
PORT=3000

# --- Real payments (optional) ---
# Stripe SECRET key (test mode: sk_test_...). Without it the app runs in
# sandbox mode with simulated charges so everything still works.
# Get one at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# --- Live video provider (optional, when you wire a real backend) ---
# Simple scaffolds live video with a sample stream. To broadcast real
# low-latency streams, connect a provider (Stream.io / Mux / Agora) and
# pass real playback URLs to POST /api/live { videoUrl }.
# LIVESTREAM_PROVIDER=
# LIVESTREAM_KEY=